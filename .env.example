# Copy to .env and fill secrets. Never commit .env.

# Required — use a long random value in any real deployment:
#   openssl rand -hex 32
JWT_SECRET=

# Optional overrides
POSTGRES_USER=orbit
POSTGRES_PASSWORD=orbit
DEPLOYMENT_ENVIRONMENT=production
SMTP_FROM=noreply@example.com
GATEWAY_HTTP_PORT=10120
GATEWAY_HEALTH_PORT=10121
MAILPIT_UI_PORT=8025
RATE_LIMIT_TRUST_PROXY=false
ORBIT_INTERNAL_TOKEN=

# SaaS settings — none are secrets; defaults leave existing deployments unchanged.
# Self-serve sign-up: off (default) or open. Enabling it also needs gateway rate
# limits (G1, merged) and the signup_verify template in orbit-notifications (merged).
AUTH_SIGNUP=off
# Add the org claim at login when the user has exactly one active membership.
AUTH_AUTO_SELECT_SINGLE_ORG=true
# Lifecycle event transport: inproc (default) or nats (production target). NATS is
# not part of this compose; set BUS_NATS_URL only when pointing at your own broker.
BUS_TRANSPORT=inproc
# BUS_NATS_URL=nats://nats.example.internal:4222

# Image pins (filled by ./scripts/pin-images.sh after build). Prefer tag@sha256 for lasting deploys.
# :edge = last v* release (or workflow_dispatch dogfood), not tip of main.
# ORBIT_AUTH_IMAGE=ghcr.io/manovaspace/orbit-auth:edge@sha256:...
# ORBIT_NOTIFICATIONS_IMAGE=ghcr.io/manovaspace/orbit-notifications:edge@sha256:...
# ORBIT_GATEWAY_IMAGE=ghcr.io/manovaspace/orbit-api-gateway:edge@sha256:...

# Source git refs used when building (tags recommended for upgrades)
ORBIT_AUTH_REF=main
ORBIT_NOTIFICATIONS_REF=main
ORBIT_GATEWAY_REF=main
